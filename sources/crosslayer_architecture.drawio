<mxfile host="app.diagrams.net">
  <diagram name="IoT Cross Layer Architecture">
    <mxGraphModel dx="827" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- IoT Sensor Nodes -->
        <mxCell id="2" value="IoT Sensor Nodes" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Physical Layer -->
        <mxCell id="3" value="Physical Layer Security" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- MAC Layer -->
        <mxCell id="4" value="MAC Layer Intrusion Detection" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="260" y="220" width="280" height="70" as="geometry"/>
        </mxCell>

        <!-- Network Layer -->
        <mxCell id="5" value="Network Layer Routing Optimization" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="240" y="330" width="320" height="70" as="geometry"/>
        </mxCell>

        <!-- Gateway -->
        <mxCell id="6" value="Gateway Node" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="440" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Cloud -->
        <mxCell id="7" value="Cloud / IoT Server" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="540" width="240" height="60" as="geometry"/>
        </mxCell>

        <!-- Arrows -->
        <mxCell id="8" style="endArrow=block;strokeWidth=2;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="9" style="endArrow=block;strokeWidth=2;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="10" style="endArrow=block;strokeWidth=2;" edge="1" parent="1" source="4" target="5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="11" style="endArrow=block;strokeWidth=2;" edge="1" parent="1" source="5" target="6">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="12" style="endArrow=block;strokeWidth=2;" edge="1" parent="1" source="6" target="7">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>